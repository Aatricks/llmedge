<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Keeps the instrumented process in the TOP oom bucket during long native
             benchmarks (FLUX.2 loads get LMK-killed as a cached process otherwise). -->
        <activity
            android:name="io.aatricks.llmedge.benchmark.KeepAliveActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
    </application>
</manifest>
